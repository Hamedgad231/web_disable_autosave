msgstr "ปิดการบันทึกอัตโนมัติ"

#. module: web_disable_autosave
#. odoo-javascript
#: code:addons/web_disable_autosave/static/src/discard_dialog.js:0
msgid "Discard changes"
msgstr "ยกเลิกการเปลี่ยนแปลง"

#. module: web_disable_autosave
#. odoo-javascript
#: code:addons/web_disable_autosave/static/src/discard_dialog.js:0
msgid "Stay here"
msgstr "อยู่ที่นี่"

#. module: web_disable_autosave
#: model:ir.module.module,summary:base.module_web_disable_autosave
msgid ""
"Stop the automatic save of Odoo: records are only saved when the user clicks"
" Save"
msgstr ""
"หยุดการบันทึกอัตโนมัติของ Odoo: "
"ระบบจะบันทึกรายการเมื่อผู้ใช้คลิกบันทึกเท่านั้น"

#. module: web_disable_autosave
#. odoo-javascript
#: code:addons/web_disable_autosave/static/src/discard_dialog.js:0
msgid ""
"This record has unsaved changes. Discard them, or stay here and click Save "
"to keep them."
msgstr ""
"รายการนี้มีการเปลี่ยนแปลงที่ยังไม่ได้บันทึก ละทิ้งการเปลี่ยนแปลง "
"หรืออยู่ที่นี่แล้วคลิกบันทึกเพื่อเก็บไว้"

#. module: web_disable_autosave
#. odoo-javascript
#: code:addons/web_disable_autosave/static/src/discard_dialog.js:0
msgid "Unsaved changes"
msgstr "การเปลี่ยนแปลงที่ไม่ได้บันทึก"
