msgstr "Änderungen verwerfen"

#. module: web_disable_autosave
#. odoo-javascript
#: code:addons/web_disable_autosave/static/src/discard_dialog.js:0
msgid "Stay here"
msgstr "Hier bleiben"

#. module: web_disable_autosave
#: model:ir.module.module,summary:base.module_web_disable_autosave
msgid ""
"Stop the automatic save of Odoo: records are only saved when the user clicks"
" Save"
msgstr ""
"Stoppen Sie das automatische Speichern von Odoo: Datensätze werden nur "
"gespeichert, wenn der Benutzer auf Speichern klickt"

#. module: web_disable_autosave
#. odoo-javascript
#: code:addons/web_disable_autosave/static/src/discard_dialog.js:0
msgid ""
"This record has unsaved changes. Discard them, or stay here and click Save "
"to keep them."
msgstr ""
"Dieser Datensatz hat nicht gespeicherte Änderungen. Verwerfen Sie sie oder "
"bleiben Sie hier und klicken Sie auf Speichern, um sie zu behalten."

#. module: web_disable_autosave
#. odoo-javascript
#: code:addons/web_disable_autosave/static/src/discard_dialog.js:0
msgid "Unsaved changes"
msgstr "Nicht gespeicherte Änderungen"
