msgstr "Değişiklikleri iptal et"

#. module: web_disable_autosave
#. odoo-javascript
#: code:addons/web_disable_autosave/static/src/discard_dialog.js:0
msgid "Stay here"
msgstr "Burada Kal"

#. module: web_disable_autosave
#: model:ir.module.module,summary:base.module_web_disable_autosave
msgid ""
"Stop the automatic save of Odoo: records are only saved when the user clicks"
" Save"
msgstr ""
"Odoo'nun otomatik kaydetmesini durdurun: kayıtlar yalnızca kullanıcı "
"Kaydet'e tıkladığında kaydedilir"

#. module: web_disable_autosave
#. odoo-javascript
#: code:addons/web_disable_autosave/static/src/discard_dialog.js:0
msgid ""
"This record has unsaved changes. Discard them, or stay here and click Save "
"to keep them."
msgstr ""
"Bu kayıtta kaydedilmemiş değişiklikler var. Değişiklikleri atın veya burada "
"kalın ve korumak için Kaydet'e tıklayın."

#. module: web_disable_autosave
#. odoo-javascript
#: code:addons/web_disable_autosave/static/src/discard_dialog.js:0
msgid "Unsaved changes"
msgstr "Kaydedilmemiş değişiklikler"
