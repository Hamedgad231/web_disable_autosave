msgid "Discard changes"
msgstr "Abandonați modificările"

#. module: web_disable_autosave
#. odoo-javascript
#: code:addons/web_disable_autosave/static/src/discard_dialog.js:0
msgid "Stay here"
msgstr "Stai aici"

#. module: web_disable_autosave
#: model:ir.module.module,summary:base.module_web_disable_autosave
msgid ""
"Stop the automatic save of Odoo: records are only saved when the user clicks"
" Save"
msgstr ""
"Opriți salvarea automată din Odoo: înregistrările sunt salvate doar când "
"utilizatorul face clic pe Salvează"

#. module: web_disable_autosave
#. odoo-javascript
#: code:addons/web_disable_autosave/static/src/discard_dialog.js:0
msgid ""
"This record has unsaved changes. Discard them, or stay here and click Save "
"to keep them."
msgstr ""
"Această înregistrare are modificări nesalvate. Renunțați la ele sau rămâneți"
" aici și faceți clic pe Salvează pentru a le păstra."

#. module: web_disable_autosave
#. odoo-javascript
#: code:addons/web_disable_autosave/static/src/discard_dialog.js:0
msgid "Unsaved changes"
msgstr "Modificări nesalvate"
