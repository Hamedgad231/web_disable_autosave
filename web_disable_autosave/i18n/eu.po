msgstr "Baztertu aldaketak"

#. module: web_disable_autosave
#. odoo-javascript
#: code:addons/web_disable_autosave/static/src/discard_dialog.js:0
msgid "Stay here"
msgstr "Geratu hemen"

#. module: web_disable_autosave
#: model:ir.module.module,summary:base.module_web_disable_autosave
msgid ""
"Stop the automatic save of Odoo: records are only saved when the user clicks"
" Save"
msgstr ""
"Gelditu Odooren gordetze automatikoa: erregistroak erabiltzaileak Gorde "
"sakatzen duenean bakarrik gordetzen dira"

#. module: web_disable_autosave
#. odoo-javascript
#: code:addons/web_disable_autosave/static/src/discard_dialog.js:0
msgid ""
"This record has unsaved changes. Discard them, or stay here and click Save "
"to keep them."
msgstr ""
"Erregistro honek gorde gabeko aldaketak ditu. Baztertu itzazu, edo geratu "
"hemen eta sakatu Gorde haiek mantentzeko."

#. module: web_disable_autosave
#. odoo-javascript
#: code:addons/web_disable_autosave/static/src/discard_dialog.js:0
msgid "Unsaved changes"
msgstr "Gorde gabeko aldaketak"
