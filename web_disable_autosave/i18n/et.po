msgid "Discard changes"
msgstr "Loobu muudatustest"

#. module: web_disable_autosave
#. odoo-javascript
#: code:addons/web_disable_autosave/static/src/discard_dialog.js:0
msgid "Stay here"
msgstr "Jää siia"

#. module: web_disable_autosave
#: model:ir.module.module,summary:base.module_web_disable_autosave
msgid ""
"Stop the automatic save of Odoo: records are only saved when the user clicks"
" Save"
msgstr ""
"Peatage Odoo automaatne salvestamine: kirjed salvestatakse ainult siis, kui "
"kasutaja klõpsab Salvesta"

#. module: web_disable_autosave
#. odoo-javascript
#: code:addons/web_disable_autosave/static/src/discard_dialog.js:0
msgid ""
"This record has unsaved changes. Discard them, or stay here and click Save "
"to keep them."
msgstr ""
"Selles kirjes on salvestamata muudatusi. Tühistage need või jääge siia ja "
"klõpsake nende säilitamiseks Salvesta."

#. module: web_disable_autosave
#. odoo-javascript
#: code:addons/web_disable_autosave/static/src/discard_dialog.js:0
msgid "Unsaved changes"
msgstr "Muudatused salvestamata"
